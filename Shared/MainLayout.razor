@inherits LayoutComponentBase

<NavMenu />

<main class="container py-4">
    @* Catches unhandled exceptions from static-rendered pages. Interactive pages are separate roots
       (islands) and are not wrapped by this boundary; see docs/ARQUITETURA.md. *@
    <ErrorBoundary @ref="errorBoundary">
        <ChildContent>@Body</ChildContent>
        <ErrorContent>
            <div class="alert alert-danger" role="alert">
                Something went wrong while showing this page. <a href="">Reload</a>
            </div>
        </ErrorContent>
    </ErrorBoundary>
</main>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private ErrorBoundary? errorBoundary;

    // Clears a previous error when the user navigates to another page.
    protected override void OnParametersSet() => errorBoundary?.Recover();
}
